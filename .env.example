# Copy to .env.local and fill in from Salla Partners Portal > My Apps > your app.
# Never commit .env.local.

# App ID (used as the S-Source header for embedded token introspection)
SALLA_APP_ID=

# OAuth credentials (App Keys section)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# Webhook secret (Webhooks/Notifications section)
# Register <NEXT_PUBLIC_APP_URL>/webhooks/salla and enable app.store.authorize.
SALLA_WEBHOOK_SECRET=

# Public base URL of this app, e.g. your ngrok URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (settings storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
