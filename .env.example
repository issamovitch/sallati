# Copy to .env.local and fill in from Salla Partners Portal > My Apps > your app.
# Never commit .env.local.

# App ID (public identifier; also the S-Source header for session introspection)
SALLA_APP_ID=

# App keys (Easy Mode)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# Webhook secret (Webhooks/Notifications, strategy "Token")
# Register: <PUBLIC_APP_URL>/webhooks/salla
SALLA_WEBHOOK_SECRET=

# Public base URL of this app (used server-side)
APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. All reads/writes use this; the browser never touches the database.
SUPABASE_SERVICE_ROLE_KEY=

# Preview fallbacks used when the dashboard is opened without a Salla session
NEXT_PUBLIC_STORE_URL=
NEXT_PUBLIC_DEMO_MERCHANT_ID=
